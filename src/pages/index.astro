---
import '../styles/styles.css'
import { getCollection } from "astro:content";
import { Image } from 'astro:assets';

import Box from "../components/Box.astro";
import Name from "../components/Name.astro";
import Hr from "../components/Hr.astro";
import Description from "../components/Description.astro";
import Role from "../components/Role.astro";
import LinkButton from "../components/LinkButton.astro";
import GitHubCommit from "../components/GitHubCommit.astro";

import _config from "../config.json";
const config: Config = _config;

import headshot from "../assets/avatar.jpg";

const all_roles = await getCollection("roles");

const pub_roles = all_roles.sort((a,b) => a.data.order - b.data.order).filter((d) => d.data.published);
---

<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{config.name}</title>
  </head>
  <body>
  <section class="section">
    <div class="container is-max-tablet">
		<Box>
			<div class="has-text-centered block">
				<figure class="image is-128x128  is-inline-block">
					<Image alt="Headshot of { name }." class="is-rounded" src={headshot} />
				</figure>
			</div>
			<Name name={config.name} />
			<Description>
				{config.desc}
			</Description>
			<div class="buttons">
			{
				config.links.map((link) => {
				  return <LinkButton {link} />;
				})
			}
			</div>
			<Hr/>
			<GitHubCommit user=`${config.pages.user}` repo=`${config.pages.repo}`/>
		</Box>
		{
			pub_roles.map((role) => {
				return <Role {role} />;
			})
		}
		<Box>
			Built using <a href="https://astro.build/">Astro</a>. 
			Source code available on <a href=`https://github.com/${config.pages.user}/${config.pages.repo}`>GitHub</a> 
			under an <a href="https://en.wikipedia.org/wiki/MIT_License">MIT license</a>.
		</Box>
    </div>
  </section>
  </body>
</html>