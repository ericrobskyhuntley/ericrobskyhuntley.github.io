---
import { getCollection } from "astro:content";
import { SEO } from "astro-seo";

import PictureBox from "../components/PictureBox.astro";
import Box from "../components/Box.astro";
import Name from "../components/Name.astro";
import Hr from "../components/Hr.astro";
import Description from "../components/Description.astro";
import Block from "../components/Block.astro";
import LinkButton from "../components/LinkButton.astro";
import GitHubCommit from "../components/GitHubCommit.astro";
import AwayMessage from "../components/AwayMessage.astro";

import '@fontsource-variable/inter';
import "../styles.scss";

import _config from "../config.json";
const config: Config = _config;

const all = await getCollection("blocks");

const published = all
	.sort((a, b) => a.data.order - b.data.order)
	.filter((d) => d.data.published);
---

<!doctype html>
<html>
	<head>
		<SEO
			title=`${config.name}`
			description=`${config.desc}`
			charset="UTF-8"
			canonical=`${Astro.url.href}`
			openGraph={{
				basic: {
					title: `${config.desc}`,
					type: "profile",
					image: "https://github.com/ericrobskyhuntley/ericrobskyhuntley.github.io/raw/refs/heads/main/src/assets/avatar.jpg",
					url: `${Astro.url.href}`,
				},
				optional: {
					description: `${config.desc}`,
					locale: "en_US",
					siteName: `${config.name}`,
				},
			}}
		/>
		<meta charset="utf-8" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link
			rel="icon"
			href="/favicon.ico"
			type="image/x-icon"
			sizes="16x16"
		/>
		<link
			rel="icon"
			href="/favicon-32x32.png"
			type="image/png"
			sizes="32x32"
		/>
		<link
			rel="icon"
			href="/favicon-192x192.png"
			type="image/png"
			sizes="192x192"
		/>
		<link
			rel="apple-touch-icon"
			href="/favicon-192x192.png"
			sizes="192x192"
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<section class="section">
			<div class="container is-max-tablet">
				<Box>
					<div class="has-text-centered block">
							<PictureBox
								file={config.avatar}
								alt={`Headshot of ${config.name}`}
							/>
					</div>
					<Name name={config.name} />
					{ config.awayMessage && (
						<AwayMessage>
							{config.awayMessage}
						</AwayMessage>
					)}
					<Description>
						{config.desc}
					</Description>
					<div class="block">
						<div class="buttons">
							{
								config.links.map((link) => {
									return <LinkButton {link} />;
								})
							}
						</div>
					</div>
					<Hr />
					<GitHubCommit
						user=`${config.pages.user}`
						repo=`${config.pages.repo}`
					/>
				</Box>
				{
					published.map((role) => {
						return <Block {role} />;
					})
				}
				<Box>
					Built using <a href="https://astro.build/">Astro</a>. Source
					code available on <a
						href=`https://github.com/${config.pages.user}/${config.pages.repo}`
						>GitHub</a
					>
					under an <a href="https://en.wikipedia.org/wiki/MIT_License"
						>MIT license</a
					>.
				</Box>
			</div>
		</section>
	</body>
</html>
