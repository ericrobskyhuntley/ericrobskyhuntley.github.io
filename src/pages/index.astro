---
import '../styles/styles.css'
import { getCollection } from "astro:content";
import { Image } from 'astro:assets';

import Box from "../components/Box.astro";
import Name from "../components/Name.astro";
import Description from "../components/Description.astro";
import Role from "../components/Role.astro";
import LinkButton from "../components/LinkButton.astro";
import GitHubCommit from "../components/GitHubCommit.astro";

import headshot from '../assets/head.jpg';

const links = [
			{
				desc: "ericrobskyhuntley",
				link: new URL("https://github.com/ericrobskyhuntley"),
				icon: "fa6-brands:github"
			},
			{
				desc: "ericrobskyhuntley@proton.me",
				link: new URL("mailto:ericrobskyhuntley@proton.me"),
				icon: "mdi:email"
			},
			{
				desc: "0000-0001-8497-0589",
				link: new URL("https://orcid.org/0000-0001-8497-0589"),
				icon: "academicons:orcid"
			}
		]

const roles = await getCollection("roles");

const roles_sort = roles.sort((a,b) => (a.data.order > b.data.order ? 1 : (b.data.order < a.data.order) ? -1 : 0));
---

<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Eric Robsky Huntley, PhD, GISP</title>
  </head>
  <body>
  <section class="section">
    <div class="container is-max-tablet">
		<Box>
			<div class="has-text-centered block">
				<figure class="image is-128x128  is-inline-block">
					<Image alt="Headshot of { name }." class="is-rounded" src={headshot} />
				</figure>
			</div>
			<Name name="Eric Robsky Huntley, PhD, GISP" />
			<Description desc="I'm a geographer, spatial data scientist, designer, and accidental software developer based in Somerville, Massachusetts." />
			<div class="buttons">
			{
				links.map((link) => {
				  return <LinkButton {link} />;
				})
			}
			</div>
			<hr>
			<GitHubCommit user="ericrobskyhuntley" repo="ericrobskyhuntley.github.io"/>
		</Box>
		{
			roles_sort.map((role) => {
				return <Role {role} />;
			})
		}
		<Box>
			Built using <a href="https://astro.build/">Astro</a>. Made available under an <a href="https://en.wikipedia.org/wiki/MIT_License">MIT license</a>. Source code available on <a href="https://github.com/ericrobskyhuntley/ericrobskyhuntley.github.io">GitHub</a>
		</Box>
    </div>
  </section>
  </body>
</html>