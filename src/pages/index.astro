---
import { getCollection } from "astro:content";
import { Image } from 'astro:assets';
import { SEO } from "astro-seo";

import Box from "../components/Box.astro";
import Name from "../components/Name.astro";
import Hr from "../components/Hr.astro";
import Description from "../components/Description.astro";
import Block from "../components/Block.astro";
import LinkButton from "../components/LinkButton.astro";
import GitHubCommit from "../components/GitHubCommit.astro";

import '../styles.scss'

import _config from "../config.json";
const config: Config = _config;

import headshot from "../assets/avatar.jpg";

const all = await getCollection("blocks");

const published = all.sort((a,b) => a.data.order - b.data.order).filter((d) => d.data.published);
---

<!DOCTYPE html>
<html>
  <head>
	<SEO
		title=`${config.name}`
		description=`${config.desc}`
		charset="UTF-8"
		canonical=`${Astro.url.href}`
		openGraph={{
			basic: {
				title: `${config.desc}`,
				type: "profile",
				image: "https://github.com/ericrobskyhuntley/ericrobskyhuntley.github.io/raw/refs/heads/main/src/assets/avatar.jpg",
				url: `${Astro.url.href}`
			},
			optional: {
				description: `${config.desc}`,
				locale: "en_US",
				siteName: `${config.name}`
			}
		}}
	/>
    <meta charset="utf-8">
	<link rel="sitemap" href="/sitemap-index.xml" />
	<link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
  </head>
  <body>
  <section class="section">
    <div class="container is-max-tablet">
		<Box>
			<div class="has-text-centered block">
				<figure class="image is-128x128  is-inline-block">
					<Image alt=`Headshot of ${ config.name }.` class="is-rounded" src={headshot} />
				</figure>
			</div>
			<Name name={config.name} />
			<Description>
				{config.desc}
			</Description>
			<div class="buttons">
			{
				config.links.map((link) => {
				  return <LinkButton {link} />;
				})
			}
			</div>
			<Hr/>
			<GitHubCommit user=`${config.pages.user}` repo=`${config.pages.repo}`/>
		</Box>
		{
			published.map((role) => {
				return <Block {role} />;
			})
		}
		<Box>
			Built using <a href="https://astro.build/">Astro</a>. 
			Source code available on <a href=`https://github.com/${config.pages.user}/${config.pages.repo}`>GitHub</a> 
			under an <a href="https://en.wikipedia.org/wiki/MIT_License">MIT license</a>.
		</Box>
    </div>
  </section>
  </body>
</html>