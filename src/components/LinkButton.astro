---
import { Icon } from 'astro-icon/components'
interface Props {
  link: string;
  desc?: string;
  icon?: string;
}
const {link, desc = link, icon = "mdi:email" } = Astro.props;
---
<a href={link} class="button is-family-monospace is-link is-light">
    <span class="icon is-small">
        <Icon name={icon}/>
    </span>
    <span>{desc}</span>
</a>