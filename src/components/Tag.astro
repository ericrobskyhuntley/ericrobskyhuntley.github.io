---
interface Props {
  url?: string;
}

const { url } = Astro.props;
---

{url ? (
  <a href={url} class="inline-tag has-text-weight-bold has-text-link"><slot/></a>
) : (
  <span class="inline-tag has-text-weight-bold has-text-link"><slot/></span>
)}

<style>
    .inline-tag {
        border-top-style: dashed;
        border-left-style: dashed;
        border-bottom-style: solid;
        border-right-style: solid;
        border-width: 1px;
        border-color: var(--bulma-link);
        padding-left: 0.15rem;
        padding-right: 0.15rem;
        margin-left: 0.1rem;
        margin-right: 0.1rem;
    }

    @media (prefers-color-scheme: dark) {
        .inline-tag {
            color:white !important;
        }
    }
</style>