---
import LinkButton from "../components/LinkButton.astro";
const { desc, title, email, url, institution, links } = Astro.props;
---
<div class="block">
    <div class="block">{ desc }</div>
    <div class="buttons">
        {
            links.map(({ desc, link, icon}) => {
                return <LinkButton {desc} {link} {icon} />;
            })
        }
</div>
</div>